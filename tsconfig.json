{
  "compilerOptions": {
    "target": "es2024",
    "lib": [
      "ES2024",
      "esnext.temporal"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [ "node" ]
  },
  "include": ["src/**/*.ts"]
}
